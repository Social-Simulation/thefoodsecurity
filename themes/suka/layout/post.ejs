<% if (page.path && (page.path.indexOf('events/2023/rice-recipe') >= 0 || page.path.indexOf('events/2024/call-for-papers-and-videos') >= 0)) { %>
    <%- partial('_pages/event-post') %>
<% } else if (page.layout === 'tags') { %>
    <!-- ## Tags Cloud ## -->
    <%- partial('_pages/tagcloud') %>
<% } else if (page.layout === 'links') { %>
    <!-- ## Links Page ## -->
    <%- partial('_pages/links') %>
<% } else if (page.layout === 'search') { %>
    <!-- ## Local Search Page ## -->
    <%- partial('_pages/search') %>
<% } else if (page.layout === 'homepage') { %>
    <!-- ## Home Page ## -->
    <%- partial('_pages/homepage') %>
<% } else if (page.layout === 'application') { %>
    <!-- ## Application Page ## -->
    <%- partial('_pages/application') %>
<% } else { %>
    <!-- ## Post ## -->
    <%- partial('_pages/post') %>
<% } %>
